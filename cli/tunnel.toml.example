# tunnel 配置文件示例。未指定 -c 时,CLI 自动读取 ./tunnel.toml。
# 所有字段可选;同名命令行 flag 覆盖此处的值。

# VPS 地址与 SSH 登录
remote_ip = "vps.example.com"
remote_ssh_port = 22
user = "tunnel"

# 本机私钥(向 VPS 认证)与 VPS 主机公钥(钉住,防冒充)
local_ssh_key = "~/.ssh/id_ed25519"
remote_ssh_pub = "~/.ssh/vps_host.pub"   # 也支持内联 "ssh-ed25519 AAAA..."

# server 侧:内网转发目标端口(sshd);client 侧:本机监听端口
local_ssh_port = 5102

# 汇合点二选一:remote_listen_port(VPS loopback 端口)或 name(VPS 上的 Unix socket)。
#
# 按名字转发(推荐):VPS 上 <remote_socket_dir>/<name>.sock,server/client 名字一致即可。
# 需要 VPS sshd 开启 StreamLocalBindUnlink yes;名字模式下 client 必须给 local_ssh_port。
# name = "nas"
# socket 目录(绝对路径)。不写 = 每次连接后自动 mkdir 并解析 $HOME/.tunnel/sockets;
# 账户不允许执行命令(nologin/ForceCommand)时必须写,并在 VPS 上预先创建该目录(chmod 700)。
# remote_socket_dir = "/home/tunnel/.tunnel/sockets"

# VPS loopback 上的汇合端口,server/client 必须一致(与 name 二选一,取消注释其中一项)。
# server 侧写 0 = 让 VPS 自动分配(实际端口见启动日志;重连会重新分配)。
# tunnel install 只支持 name;写了 remote_listen_port 的配置不能用于 install。
# remote_listen_port = 5102

# tunnel install 专用:服务器 profile,区分不同的 VPS(服务名 tunnel-<profile>,每个 profile 一个服务;
# 设备名字 name 只保存在服务配置里,改名不改变服务名)。
# 不写 = default;命令行 --profile 优先。tunnel server / client 忽略此项。
# profile = "home"
